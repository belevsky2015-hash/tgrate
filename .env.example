# --- Telegram Wallet ---------------------------------------------------
# Кошелёк → Deposit → P2P Market → My Profile → API Keys → Create API key
WALLET_API_KEY=

WALLET_TIER=basic              # basic (обмен 0,9%) | trader (0,09%)
WALLET_P2P_ROLE=taker          # taker (0%) | maker (RUB 2%, KZT/UAH/USD/EUR/TRY 1,2%)
WALLET_SIDE_WHEN_BUYING=SELL   # сторона объявления, у которого мы покупаем
WALLET_MIN_EXECUTE_RATE=0.90   # отсекать мейкеров с низким процентом сделок
WALLET_MERCHANTS_ONLY=0
WALLET_PAYMENTS=               # например: sberbank,tinkoff

SAFETY_PCT=0                   # общий запас, вычитается из итога
TRACK_ROUTES=                  # точный график раз в минуту: USDT.WALLET>RUB.BANK:1000,...

# --- Панель ------------------------------------------------------------
HOST=127.0.0.1
PORT=8080
PANEL_TOKEN=                   # пусто = без авторизации, ставьте на публичном хосте

# --- Юзербот (сессия у вас уже есть) -----------------------------------
TG_API_ID=
TG_API_HASH=
TG_SESSION=                    # StringSession
TG_ALLOWED_USERS=
API_BASE=http://127.0.0.1:8080

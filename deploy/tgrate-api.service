[Unit]
Description=Курс через Telegram Wallet — панель
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/opt/tgrate
EnvironmentFile=/opt/tgrate/.env
ExecStart=/opt/tgrate/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8080
Restart=always
RestartSec=5

# База со сделками должна пережить рестарт, остальное закрыто
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/tgrate/data

[Install]
WantedBy=multi-user.target
